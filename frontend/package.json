{
  "name": "songbook-frontend",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "build-ci": "node build-ci.js && vite build",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "extract": "node extract.js",
    "gen:api": "pnpm --filter songbook-backend run gen:openapi ../frontend/src/store/openapi.json && pnpm --filter openapi-codegen run gen",
    "types": "i18next-cli types",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cantarell": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@isbl/ts-utils": "^1.0.2",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.1",
    "@sentry/react": "^10.68.0",
    "@tombatossals/chords-db": "^0.5.1",
    "@tombatossals/react-chords": "^0.2.10",
    "@types/file-saver": "^2.0.7",
    "@types/loadable__component": "^5.13.9",
    "@types/luxon": "^3.4.2",
    "@types/react-loadable": "^5.5.11",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "comlink": "^4.4.2",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.3.0",
    "localforage": "^1.10.0",
    "luxon": "^3.4.4",
    "openapi-fetch": "^0.17.0",
    "p-queue": "^9.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.11",
    "react-loadable": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.1.0",
    "xorshift": "^1.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.0",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "devcert": "^1.2.2",
    "http-proxy": "^1.18.1",
    "i18next-cli": "^1.67.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "1.62.0",
    "postcss": "^8.5.23",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^4.1.10"
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.9.0 <12.0.0",
      "onFail": "download"
    }
  }
}
